<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración — Alimentos del Alba</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/stylesheets/main-theme.css">
    <link rel="shortcut icon" href="/images/logo2.jpg" type="image/x-icon">
</head>
<body>

    <!-- Header Navbar -->
    <header class="alba-navbar">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a href="/admin" class="navbar-brand">
                <img src="/images/logo2.jpg" alt="Logo Alba" class="brand-logo">
                <span>Alimentos del Alba <span class="badge badge-alba-amber ms-2">Admin</span></span>
            </a>
            <div class="d-flex align-items-center gap-3">
                <span class="text-light small d-none d-md-inline"><i class="bi bi-shield-check text-warning me-1"></i> Sesión Administrador</span>
                <a href="/auth/logout" class="btn btn-sm btn-alba-danger">
                    <i class="bi bi-box-arrow-right me-1"></i> Salir
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container my-5">

        <!-- Mini Hero -->
        <div class="alba-hero-mini">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h1><i class="bi bi-speedometer2 text-warning me-2"></i> Panel de Control Administrativo</h1>
                    <p>Gestión integral de personal, registro en tiempo real e historial de asistencias.</p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <a href="/tabGeneral" class="btn btn-alba-primary">
                        <i class="bi bi-people-fill me-1"></i> Gestionar Empleados
                    </a>
                </div>
            </div>
        </div>

        <!-- Action Cards Grid -->
        <div class="row g-4">
            
            <!-- Card 1: Tabla General -->
            <div class="col-md-4">
                <div class="alba-card h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="p-3 bg-amber-light text-warning rounded-3 fs-3" style="background: var(--primary-light);">
                                <i class="bi bi-person-lines-fill text-warning"></i>
                            </div>
                            <div>
                                <h3 class="h5 mb-1">Directorio de Empleados</h3>
                                <span class="badge badge-alba-amber">Gestión Completa</span>
                            </div>
                        </div>
                        <p class="text-muted small">
                            Consulta, edita, agrega o elimina registros de empleados. Administra cargos, números de cédula y contactos.
                        </p>
                    </div>
                    <a href="/tabGeneral" class="btn btn-alba-primary w-100 mt-3">
                        Ver Tabla General <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Card 2: Historial Asistencia -->
            <div class="col-md-4">
                <div class="alba-card h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="p-3 text-info rounded-3 fs-3" style="background: var(--info-light);">
                                <i class="bi bi-calendar-check text-info"></i>
                            </div>
                            <div>
                                <h3 class="h5 mb-1">Historial de Asistencia</h3>
                                <span class="badge badge-alba-slate">Registros & Filtros</span>
                            </div>
                        </div>
                        <p class="text-muted small">
                            Revisa el reporte de entradas y salidas de todos los trabajadores registrado por fecha o empleado.
                        </p>
                    </div>
                    <a href="/historial-asistencia" class="btn btn-alba-secondary w-100 mt-3">
                        Ver Historial <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Card 3: Escanear QR -->
            <div class="col-md-4">
                <div class="alba-card h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="p-3 text-emerald rounded-3 fs-3" style="background: var(--emerald-light);">
                                <i class="bi bi-qr-code-scan text-success"></i>
                            </div>
                            <div>
                                <h3 class="h5 mb-1">Escanear Asistencia QR</h3>
                                <span class="badge badge-alba-emerald">Escáner Vivo</span>
                            </div>
                        </div>
                        <p class="text-muted small">
                            Inicia la cámara para registrar marcajes de asistencia rápida leyendo el código QR del personal.
                        </p>
                    </div>
                    <a href="/escanear-asistencia" class="btn btn-alba-emerald w-100 mt-3">
                        Escanear QR <i class="bi bi-qr-code ms-1"></i>
                    </a>
                </div>
            </div>

        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>