<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración — Alimentos del Alba</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/stylesheets/main-theme.css">
    <link rel="shortcut icon" href="/images/logo2.jpg" type="image/x-icon">
</head>
<body>

    <!-- Header Navbar -->
    <header class="alba-navbar">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a href="/admin" class="navbar-brand">
                <img src="/images/logo2.jpg" alt="Logo Alba" class="brand-logo">
                <span>Alimentos del Alba <span class="badge badge-alba-amber ms-2">Admin</span></span>
            </a>
            <div class="d-flex align-items-center gap-3">
                <span class="text-light small d-none d-md-inline"><i class="bi bi-shield-check text-warning me-1"></i> Sesión Administrador</span>
                <a href="/auth/logout" class="btn btn-sm btn-alba-danger">
                    <i class="bi bi-box-arrow-right me-1"></i> Salir
                </a>
            </div>
        </div>
    </header>

    <!-- Floating Toast Notification Container -->
    <% if (locals.message && locals.message.text) { %>
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
            <div id="albaToast" class="toast align-items-center text-white bg-<%= locals.message.type === 'success' ? 'success' : 'danger' %> border-0 show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center gap-2">
                        <i class="bi bi-<%= locals.message.type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill' %> fs-5"></i>
                        <div><%- locals.message.text %></div>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Main Content -->
    <main class="container my-5">

        <!-- Mini Hero -->
        <div class="alba-hero-mini mb-4">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h1><i class="bi bi-speedometer2 text-warning me-2"></i> Panel de Control Administrativo</h1>
                    <p>Gestión integral de personal, asignación de jornadas, reporte de asistencias e inteligencia de marcaje.</p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <a href="/tabGeneral" class="btn btn-alba-primary">
                        <i class="bi bi-people-fill me-1"></i> Gestionar Empleados
                    </a>
                </div>
            </div>
        </div>

        <!-- 🏆 CUADRO DE HONOR — EMPLEADO MÁS RESPONSABLE -->
        <% if (locals.empleadoMasResponsable) { %>
            <div class="card border-0 mb-4 shadow-sm rounded-4 text-white" style="background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%); border-left: 5px solid #F59E0B !important;">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="position-relative">
                                <% if (empleadoMasResponsable.foto_perfil) { %>
                                    <img src="<%= empleadoMasResponsable.foto_perfil %>" alt="Foto Empleado" class="rounded-circle border border-2 border-warning shadow" style="width: 70px; height: 70px; object-fit: cover;">
                                <% } else { %>
                                    <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center fw-bold fs-3 shadow" style="width: 70px; height: 70px;">
                                        <%= empleadoMasResponsable.nombre.charAt(0) %>
                                    </div>
                                <% } %>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark fs-6 shadow">
                                    🏆 1º
                                </span>
                            </div>
                            <div>
                                <span class="badge bg-warning text-dark fw-bold mb-1">
                                    <i class="bi bi-trophy-fill me-1"></i> Empleado Más Responsable
                                </span>
                                <h3 class="h4 text-white mb-0 fw-bold">
                                    <%= empleadoMasResponsable.nombre %> <%= empleadoMasResponsable.apellido || '' %>
                                </h3>
                                <p class="text-white-50 mb-0 small">
                                    <i class="bi bi-briefcase me-1 text-warning"></i> <%= empleadoMasResponsable.cargo || 'Personal' %> — 
                                    <i class="bi bi-building me-1 text-warning"></i> <%= empleadoMasResponsable.departamento || 'Planta' %>
                                </p>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <div class="bg-dark bg-opacity-50 p-2 px-3 rounded-3 text-center border border-secondary border-opacity-25">
                                <div class="fs-4 fw-bold text-warning mb-0"><%= empleadoMasResponsable.total_asistencias %></div>
                                <div class="text-white-50 small">Jornadas Marcadass</div>
                            </div>
                            <div class="bg-dark bg-opacity-50 p-2 px-3 rounded-3 text-center border border-secondary border-opacity-25">
                                <div class="fs-4 fw-bold text-emerald mb-0" style="color: #10B981;"><%= empleadoMasResponsable.marcajes_perfectos %></div>
                                <div class="text-white-50 small">Marcajes Perfectos</div>
                            </div>
                            <div class="bg-dark bg-opacity-50 p-2 px-3 rounded-3 text-center border border-secondary border-opacity-25">
                                <div class="fs-4 fw-bold text-info mb-0">100%</div>
                                <div class="text-white-50 small">Compromiso</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- Action Cards Grid -->
        <div class="row g-4">
            
            <!-- Card 1: Tabla General & Directorio -->
            <div class="col-md-4">
                <div class="alba-card h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-3 bg-amber-light text-warning rounded-3 fs-3" style="background: var(--primary-light);">
                                    <i class="bi bi-person-lines-fill text-warning"></i>
                                </div>
                                <div>
                                    <h3 class="h5 mb-1">Directorio Empleados</h3>
                                    <span class="badge badge-alba-amber">
                                        Total: <%= (locals.stats && locals.stats.totalEmpleados) ? locals.stats.totalEmpleados : 0 %>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <p class="text-muted small">
                            Consulta, edita, agrega o elimina registros de empleados. Configura el <strong>Tipo de Jornada</strong> para habilitar su código QR.
                        </p>
                        <div class="small fw-semibold text-success mt-2">
                            <i class="bi bi-qr-code text-success me-1"></i> <%= (locals.stats && locals.stats.qrHabilitados) ? locals.stats.qrHabilitados : 0 %> con QR Habilitado
                        </div>
                    </div>
                    <a href="/tabGeneral" class="btn btn-alba-primary w-100 mt-3">
                        Ver Tabla General <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Card 2: Historial Asistencia & Exportación Excel -->
            <div class="col-md-4">
                <div class="alba-card h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-3 text-info rounded-3 fs-3" style="background: var(--info-light);">
                                    <i class="bi bi-calendar-check text-info"></i>
                                </div>
                                <div>
                                    <h3 class="h5 mb-1">Historial & Excel</h3>
                                    <span class="badge badge-alba-slate">
                                        Total: <%= (locals.stats && locals.stats.totalMarcajes) ? locals.stats.totalMarcajes : 0 %>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <p class="text-muted small">
                            Revisa el reporte de entradas y salidas. Descarga reportes en <strong>Excel (.xlsx)</strong> con diagnósticos de jornada y ajuste manual.
                        </p>
                    </div>
                    <a href="/historial-asistencia" class="btn btn-alba-secondary w-100 mt-3">
                        Ver Historial <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Card 3: Escanear QR -->
            <div class="col-md-4">
                <div class="alba-card h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-3 text-emerald rounded-3 fs-3" style="background: var(--emerald-light);">
                                    <i class="bi bi-qr-code-scan text-success"></i>
                                </div>
                                <div>
                                    <h3 class="h5 mb-1">Escanear QR</h3>
                                    <span class="badge badge-alba-emerald">Escáner Vivo</span>
                                </div>
                            </div>
                        </div>
                        <p class="text-muted small">
                            Inicia la cámara para registrar marcajes de asistencia rápida leyendo el código QR del personal autorizados.
                        </p>
                    </div>
                    <a href="/escanear-asistencia" class="btn btn-alba-emerald w-100 mt-3">
                        Escanear QR <i class="bi bi-qr-code ms-1"></i>
                    </a>
                </div>
            </div>

        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toastEl = document.getElementById('albaToast');
            if (toastEl) {
                const toast = new bootstrap.Toast(toastEl, { delay: 4500 });
                toast.show();
            }
        });
    </script>
</body>
</html>