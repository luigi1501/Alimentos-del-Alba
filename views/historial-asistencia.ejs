<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historial de Asistencia — Alimentos del Alba</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/stylesheets/main-theme.css">
    <link rel="shortcut icon" href="/images/logo2.jpg" type="image/x-icon">
</head>
<body>

    <!-- Header Navbar -->
    <header class="alba-navbar">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a href="/admin" class="navbar-brand">
                <img src="/images/logo2.jpg" alt="Logo Alba" class="brand-logo">
                <span>Alimentos del Alba</span>
            </a>
            <div class="d-flex align-items-center gap-2">
                <a href="/admin" class="btn btn-sm btn-alba-secondary">
                    <i class="bi bi-house me-1"></i> Menú Admin
                </a>
                <a href="/" class="btn btn-sm btn-alba-danger">
                    <i class="bi bi-box-arrow-right me-1"></i> Salir
                </a>
            </div>
        </div>
    </header>

    <main class="container my-4">

        <!-- Banner Header -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1"><i class="bi bi-calendar-check text-info me-2"></i> Historial de Marcajes</h1>
                <p class="text-muted mb-0">Registro cronológico de entradas y salidas del personal.</p>
            </div>
            <div>
                <span class="badge badge-alba-amber fs-6 px-3 py-2">
                    <i class="bi bi-list-check me-1"></i> <%= (historial && historial.length) ? historial.length : 0 %> Registros
                </span>
            </div>
        </div>

        <!-- Filter Search Bar -->
        <div class="alba-card p-3 mb-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="filter-input" class="form-control border-start-0 ps-0" placeholder="Buscar por empleado, cédula, fecha o departamento...">
            </div>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div><%= error %></div>
            </div>
        <% } %>

        <!-- History Table -->
        <div class="alba-table-container">
            <div class="table-responsive">
                <table class="alba-table" id="tabla-historial">
                    <thead>
                        <tr>
                            <th># ID</th>
                            <th>Empleado</th>
                            <th>Cargo / Dpto</th>
                            <th>Cédula</th>
                            <th>Fecha</th>
                            <th>Hora Entrada</th>
                            <th>Hora Salida</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (historial && historial.length > 0) { %>
                            <% historial.forEach(registro => { %>
                                <tr>
                                    <td class="fw-bold text-muted">#<%= registro.id_asistencia %></td>
                                    <td class="fw-bold text-dark">
                                        <%= registro.nombre ? (registro.nombre + ' ' + (registro.apellido || '')) : 'Mi Historial' %>
                                    </td>
                                    <td>
                                        <span class="badge badge-alba-slate"><%= registro.cargo || 'N/A' %></span>
                                        <div class="small text-muted"><%= registro.departamento || '' %></div>
                                    </td>
                                    <td><code><%= registro.cedula || 'N/A' %></code></td>
                                    <td><i class="bi bi-calendar3 me-1 text-muted"></i><%= registro.fechaFormatted || registro.fecha %></td>
                                    <td><span class="text-success fw-semibold"><i class="bi bi-arrow-right-short"></i> <%= registro.horaEntradaFormatted || registro.hora_entrada %></span></td>
                                    <td>
                                        <% if (registro.hora_salida && registro.hora_salida !== 'N/A') { %>
                                            <span class="text-primary fw-semibold"><i class="bi bi-arrow-left-short"></i> <%= registro.horaSalidaFormatted || registro.hora_salida %></span>
                                        <% } else { %>
                                            <span class="text-warning fw-semibold"><i class="bi bi-clock-history me-1"></i> Pendiente</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (registro.hora_salida && registro.hora_salida !== 'N/A') { %>
                                            <span class="badge badge-alba-emerald"><i class="bi bi-check-all"></i> Completo</span>
                                        <% } else { %>
                                            <span class="badge badge-alba-amber"><i class="bi bi-hourglass-split"></i> En Jornada</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No hay registros de asistencia en el historial.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const filterInput = document.getElementById('filter-input');
            const tbody = document.querySelector('#tabla-historial tbody');
            const rows = tbody.querySelectorAll('tr');

            if (filterInput) {
                filterInput.addEventListener('input', function() {
                    const query = this.value.toLowerCase().trim();
                    rows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(query) ? '' : 'none';
                    });
                });
            }
        });
    </script>
</body>
</html>