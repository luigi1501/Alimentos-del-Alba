<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historial de Asistencia — Alimentos del Alba</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/stylesheets/main-theme.css">
    <link rel="shortcut icon" href="/images/logo2.jpg" type="image/x-icon">
</head>
<body>

    <!-- Header Navbar Admin -->
    <header class="alba-navbar">
        <div class="container-fluid d-flex justify-content-between align-items-center flex-wrap gap-2">
            <a href="/admin" class="navbar-brand">
                <img src="/images/logo2.jpg" alt="Logo Alba" class="brand-logo">
                <span>Alimentos del Alba <span class="badge badge-alba-amber ms-2">Admin</span></span>
            </a>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <!-- Botón Notificación Pendientes -->
                <a href="<%= locals.pendientesTargetUrl || '/tabGeneral?filter=pendientes' %>" class="btn btn-sm position-relative d-inline-flex align-items-center gap-2 <%= (locals.pendientesCount && locals.pendientesCount > 0) ? 'btn-alba-warning-glow' : 'btn-outline-secondary text-light' %>" title="Usuarios y marcajes pendientes por atender">
                    <i class="bi bi-bell-fill <%= (locals.pendientesCount && locals.pendientesCount > 0) ? 'text-warning pulse-icon' : '' %>"></i>
                    <span class="d-none d-sm-inline font-heading">Pendientes</span>
                    <% if (locals.pendientesCount && locals.pendientesCount > 0) { %>
                        <span class="badge rounded-pill bg-danger shadow-sm badge-pulse">
                            <%= locals.pendientesCount %>
                        </span>
                    <% } else { %>
                        <span class="badge bg-secondary rounded-pill" style="font-size: 0.7rem;">0</span>
                    <% } %>
                </a>

                <a href="/admin" class="btn btn-sm btn-alba-secondary">
                    <i class="bi bi-house me-1"></i> Menú Admin
                </a>
                <a href="/auth/logout" class="btn btn-sm btn-alba-danger">
                    <i class="bi bi-box-arrow-right me-1"></i> Salir
                </a>
            </div>
        </div>
    </header>

    <!-- Toast Notification Container -->
    <% if (locals.message && locals.message.text) { %>
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
            <div id="albaToast" class="toast align-items-center text-white bg-<%= locals.message.type === 'success' ? 'success' : 'danger' %> border-0 show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center gap-2">
                        <i class="bi bi-<%= locals.message.type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill' %> fs-5"></i>
                        <div><%- locals.message.text %></div>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    <% } %>

    <main class="container my-4">

        <!-- Banner Header & Action Buttons -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1"><i class="bi bi-calendar-check text-info me-2"></i> Historial de Marcajes e Inteligencia de Asistencia</h1>
                <p class="text-muted mb-0">Control general de entradas, salidas, diagnóstico de turnos y ajuste manual para desbloqueo de QR.</p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button type="button" class="btn btn-alba-emerald" data-bs-toggle="modal" data-bs-target="#modalExportarExcel">
                    <i class="bi bi-file-earmark-excel-fill me-1"></i> Exportar a Excel (.xlsx)
                </button>
                <span class="badge badge-alba-amber fs-6 px-3 py-2">
                    <i class="bi bi-list-check me-1"></i> <%= (historial && historial.length) ? historial.length : 0 %> Registros
                </span>
                <% const countPendientesSalida = locals.countAsistenciasPendientes || (historial ? historial.filter(h => !h.hora_salida || h.hora_salida === 'N/A').length : 0); %>
                <span class="badge <%= countPendientesSalida > 0 ? 'bg-danger text-white badge-pulse' : 'bg-secondary text-white' %> fs-6 px-3 py-2">
                    <i class="bi bi-clock-history me-1"></i> <%= countPendientesSalida %> Pendientes de Salida
                </span>
            </div>
        </div>

        <!-- Filter Search Bar & Quick Filters -->
        <div class="alba-card p-3 mb-4">
            <div class="row g-3 align-items-center">
                <div class="col-lg-7 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="filter-input" class="form-control border-start-0 ps-0" placeholder="Buscar por empleado, cédula, fecha, observación o departamento...">
                    </div>
                </div>
                <div class="col-lg-5 col-md-6 d-flex gap-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary flex-fill filter-btn active" data-filter="all">Todos los Marcajes</button>
                    <button type="button" class="btn btn-sm btn-outline-warning flex-fill filter-btn" data-filter="pendientes">
                        ⚠️ Pendientes (<%= countPendientesSalida %>)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-success flex-fill filter-btn" data-filter="completados">Completados</button>
                </div>
            </div>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0 fs-5"></i>
                <div><%= error %></div>
            </div>
        <% } %>

        <!-- History Table Container -->
        <div class="alba-table-container shadow-md">
            <table class="alba-table" id="tabla-historial">
                <thead>
                    <tr>
                        <th style="width: 65px;" class="text-nowrap"># ID</th>
                        <th class="text-nowrap" style="min-width: 160px;">Empleado</th>
                        <th class="text-nowrap" style="min-width: 120px;">Cargo / Dpto</th>
                        <th class="text-nowrap" style="min-width: 140px;">Jornada Asignada</th>
                        <th class="text-nowrap" style="min-width: 110px;">Fecha</th>
                        <th class="text-nowrap" style="min-width: 115px;">Hora Entrada</th>
                        <th class="text-nowrap" style="min-width: 115px;">Hora Salida</th>
                        <th class="text-nowrap" style="min-width: 140px;">Evaluación / Duración</th>
                        <th style="min-width: 260px; max-width: 340px;">Observaciones e Incidencias</th>
                        <th class="text-center text-nowrap" style="width: 140px;">Acción Admin</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (historial && historial.length > 0) { %>
                        <% historial.forEach(registro => { %>
                            <% const esPendienteSalida = !registro.hora_salida || registro.hora_salida === 'N/A'; %>
                            <tr data-status="<%= esPendienteSalida ? 'pendiente' : 'completado' %>" class="<%= (registro.alertaTipo === 'danger' || esPendienteSalida) ? 'alba-tr-danger' : (registro.alertaTipo === 'warning' ? 'alba-tr-warning' : '') %>">
                                <td class="fw-bold text-muted text-nowrap">#<%= registro.id_asistencia %></td>
                                <td>
                                    <div class="fw-bold text-dark"><%= registro.nombre ? (registro.nombre + ' ' + (registro.apellido || '')) : 'N/A' %></div>
                                    <small class="text-muted text-nowrap">C.I: V-<%= registro.cedula || 'N/A' %></small>
                                </td>
                                <td>
                                    <div><span class="badge badge-alba-slate text-nowrap"><%= registro.cargo || 'General' %></span></div>
                                    <small class="text-muted"><%= registro.departamento || 'Planta' %></small>
                                </td>
                                <td class="text-nowrap">
                                    <small class="fw-semibold text-primary"><i class="bi bi-clock me-1"></i><%= registro.tipo_jornada || 'Diurna (8-5)' %></small>
                                </td>
                                <td class="text-nowrap">
                                    <i class="bi bi-calendar3 me-1 text-muted"></i><%= registro.fechaFormatted || registro.fecha %>
                                </td>
                                <td class="text-nowrap">
                                    <span class="text-success fw-semibold"><i class="bi bi-box-arrow-in-right me-1"></i><%= registro.horaEntradaFormatted || registro.hora_entrada %></span>
                                </td>
                                <td class="text-nowrap">
                                    <% if (!esPendienteSalida) { %>
                                        <span class="text-primary fw-semibold">
                                            <i class="bi bi-box-arrow-left me-1"></i><%= registro.horaSalidaFormatted || registro.hora_salida %>
                                            <% if (registro.salida_manual) { %>
                                                <span class="badge bg-secondary ms-1" style="font-size: 0.65rem;">Manual</span>
                                            <% } %>
                                        </span>
                                    <% } else { %>
                                        <span class="badge bg-danger text-white badge-pulse"><i class="bi bi-clock-history me-1"></i> Pendiente Salida</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="text-nowrap"><strong class="text-dark small"><%= registro.duracionJornada || 'N/A' %></strong></div>
                                    <span class="badge badge-alba-amber text-nowrap" style="font-size: 0.7rem;"><%= registro.evaluacionTurno || 'Normal' %></span>
                                </td>
                                <td class="col-obs" style="min-width: 260px; max-width: 340px; white-space: normal; word-break: break-word;">
                                    <div class="small <%= (registro.alertaTipo === 'danger' || esPendienteSalida) ? 'text-danger fw-bold' : (registro.alertaTipo === 'warning' ? 'text-warning fw-semibold' : 'text-success') %>">
                                        <%= registro.observacionInteligente || (esPendienteSalida ? 'Jornada activa. Salida pendiente de marcaje.' : 'Normal') %>
                                    </div>
                                </td>
                                <td class="text-center text-nowrap" style="width: 140px;">
                                    <% if (esPendienteSalida) { %>
                                        <button type="button" 
                                                class="btn btn-sm btn-amber-action text-nowrap"
                                                data-id="<%= registro.id_asistencia %>"
                                                data-empleado="<%= registro.nombre %> <%= registro.apellido || '' %>"
                                                data-fecha="<%= registro.fechaFormatted || registro.fecha %>"
                                                data-entrada="<%= registro.horaEntradaFormatted || registro.hora_entrada %>"
                                                data-bs-toggle="modal" 
                                                data-bs-target="#modalAjusteManual"
                                                title="Registrar salida manual y desbloquear QR">
                                            <i class="bi bi-key-fill me-1"></i> Salida Manual
                                        </button>
                                    <% } else { %>
                                        <span class="badge badge-alba-emerald text-nowrap"><i class="bi bi-check-all me-1"></i> Cerrado</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-warning"></i>
                                No hay registros de asistencia en el historial.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        </div>

    </main>

    <!-- Modal 1: Exportar a Excel -->
    <div class="modal fade" id="modalExportarExcel" tabindex="-1" aria-labelledby="modalExportarExcelLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header bg-dark text-white rounded-top-4">
                    <h5 class="modal-title h6 fw-bold" id="modalExportarExcelLabel">
                        <i class="bi bi-file-earmark-excel-fill text-success me-2 fs-5"></i> Exportar Historial a Excel (.xlsx)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/exportar-excel-historial" method="GET">
                    <div class="modal-body p-4">
                        <p class="text-muted small mb-3">Selecciona el período o empleado para descargar la hoja de cálculo estilizada con diagnósticos e inteligencia de marcaje.</p>
                        
                        <!-- Selector de Mes -->
                        <div class="mb-3">
                            <label for="select-mes" class="form-label fw-bold small text-dark">Período / Mes *</label>
                            <select id="select-mes" name="mes" class="form-select alba-input" required>
                                <option value="todos" selected>Todos los meses (Historial Completo)</option>
                                <% 
                                    // Generar opciones dinámicas para el año actual y anterior
                                    const now = new Date();
                                    const currentYear = now.getFullYear();
                                    const mesesNombres = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
                                    
                                    for (let y = currentYear; y >= currentYear - 1; y--) {
                                        for (let m = 11; m >= 0; m--) {
                                            const val = `${y}-${String(m + 1).padStart(2, '0')}`;
                                            const label = `${mesesNombres[m]} ${y}`;
                                %>
                                    <option value="<%= val %>"><%= label %></option>
                                <% 
                                        }
                                    }
                                %>
                            </select>
                        </div>

                        <!-- Selector de Empleado Específico -->
                        <div class="mb-3">
                            <label for="select-empleado" class="form-label fw-bold small text-dark">Empleado (Opcional)</label>
                            <select id="select-empleado" name="empleadoId" class="form-select alba-input">
                                <option value="todos" selected>Todos los Empleados (Reporte General)</option>
                                <% if (locals.empleados && empleados.length > 0) { %>
                                    <% empleados.forEach(emp => { %>
                                        <option value="<%= emp.id %>"><%= emp.nombre %> <%= emp.apellido || '' %> (C.I: V-<%= emp.cedula %>)</option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>

                        <div class="p-3 bg-light rounded-3 border small text-muted">
                            <i class="bi bi-info-circle text-primary me-1"></i> El archivo exportado incluirá totales estadísticos al final, evaluación de puntualidad/horas extra y diagnósticos de escaneo.
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4 border-top">
                        <button type="button" class="btn btn-alba-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-alba-emerald">
                            <i class="bi bi-download me-1"></i> Descargar Excel (.xlsx)
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal 2: Ajuste Manual de Salida & Desbloqueo de QR -->
    <div class="modal fade" id="modalAjusteManual" tabindex="-1" aria-labelledby="modalAjusteManualLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header bg-danger text-white rounded-top-4">
                    <h5 class="modal-title h6 fw-bold" id="modalAjusteManualLabel">
                        <i class="bi bi-key-fill me-2 fs-5"></i> Registración de Salida Manual (Desbloqueo de QR)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/cerrar-salida-manual" method="POST">
                    <input type="hidden" name="id_asistencia" id="manual_id_asistencia">
                    <div class="modal-body p-4">
                        <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
                            <div class="small">
                                Al registrar manualmente la hora de salida para este empleado, el sistema **DESBLOQUEARÁ AUTOMÁTICAMENTE su Código QR** para permitir nuevos marcajes.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1">Empleado:</label>
                            <div class="fw-bold text-dark fs-6" id="manual_empleado_nombre">-</div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Fecha de Jornada:</label>
                                <div class="fw-semibold text-primary" id="manual_fecha">-</div>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Hora de Entrada:</label>
                                <div class="fw-semibold text-success" id="manual_hora_entrada">-</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="hora_salida" class="form-label fw-bold small text-dark">Hora de Salida Manual *</label>
                            <input type="time" id="hora_salida" name="hora_salida" class="form-control alba-input" value="17:00" required>
                            <div class="form-text small">Ingresa la hora en que finalizó su jornada (ej: 17:00 para las 5:00 PM).</div>
                        </div>

                        <div class="mb-1">
                            <label for="observacion_salida" class="form-label fw-bold small text-dark">Motivo / Observación <span class="text-muted fw-normal">(Opcional)</span></label>
                            <textarea id="observacion_salida" name="observacion" class="form-control alba-input" rows="2"
                                      placeholder="Ej: Salida anticipada por cita médica, permiso aprobado por supervisión, turno completado sin escaneo..."></textarea>
                            <div class="form-text small"><i class="bi bi-info-circle me-1"></i> Este motivo quedará registrado en el historial como observación del marcaje.</div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4 border-top">
                        <button type="button" class="btn btn-alba-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-alba-primary">
                            <i class="bi bi-unlock-fill me-1"></i> Guardar Salida & Desbloquear QR
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const filterInput = document.getElementById('filter-input');
            const tbody = document.querySelector('#tabla-historial tbody');
            const rows = tbody.querySelectorAll('tr[data-status]');
            const filterBtns = document.querySelectorAll('.filter-btn');

            let currentFilter = 'all';

            // Comprobar parámetro en la URL (?filter=pendientes)
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('filter') === 'pendientes') {
                currentFilter = 'pendientes';
                filterBtns.forEach(btn => {
                    btn.classList.toggle('active', btn.dataset.filter === 'pendientes');
                });
            }

            function applyFilters() {
                const query = filterInput ? filterInput.value.toLowerCase().trim() : '';
                rows.forEach(row => {
                    const status = row.dataset.status;
                    const text = row.textContent.toLowerCase();

                    let matchesFilter = true;
                    if (currentFilter === 'pendientes') {
                        matchesFilter = (status === 'pendiente');
                    } else if (currentFilter === 'completados') {
                        matchesFilter = (status === 'completado');
                    }

                    const matchesSearch = text.includes(query);

                    if (matchesFilter && matchesSearch) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            // Auto-Show Toast
            const toastEl = document.getElementById('albaToast');
            if (toastEl) {
                const toast = new bootstrap.Toast(toastEl, { delay: 4500 });
                toast.show();
            }

            // Eventos de filtro y búsqueda
            if (filterInput) {
                filterInput.addEventListener('input', applyFilters);
            }

            filterBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    currentFilter = this.dataset.filter;
                    applyFilters();
                });
            });

            applyFilters();

            // Modal Ajuste Manual Data Binding
            const botonesAjuste = document.querySelectorAll('.btn-ajuste-manual');
            botonesAjuste.forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.dataset.id;
                    const empleado = this.dataset.empleado;
                    const fecha = this.dataset.fecha;
                    const entrada = this.dataset.entrada;

                    document.getElementById('manual_id_asistencia').value = id;
                    document.getElementById('manual_empleado_nombre').textContent = empleado;
                    document.getElementById('manual_fecha').textContent = fecha;
                    document.getElementById('manual_hora_entrada').textContent = entrada;
                });
            });
        });
    </script>
</body>
</html>