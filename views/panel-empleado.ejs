<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel del Empleado — Alimentos del Alba</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/stylesheets/main-theme.css">
    <link rel="shortcut icon" href="/images/logo2.jpg" type="image/x-icon">
</head>
<body>

    <!-- Header Navbar -->
    <header class="alba-navbar">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a href="/auth/panel-empleado" class="navbar-brand">
                <img src="/images/logo2.jpg" alt="Logo Alba" class="brand-logo">
                <span>Alimentos del Alba <span class="badge badge-alba-emerald ms-2">Panel Empleado</span></span>
            </a>
            <div class="d-flex align-items-center gap-2">
                <a href="/auth/historial-asistencia" class="btn btn-sm btn-alba-secondary">
                    <i class="bi bi-calendar-event me-1"></i> Mi Historial
                </a>
                <a href="/auth/logout" class="btn btn-sm btn-alba-danger">
                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                </a>
            </div>
        </div>
    </header>

    <main class="container my-4">

        <!-- Flash Message Alerts -->
        <% if (locals.message && locals.message.text) { %>
            <div class="alert alert-<%= locals.message.type === 'success' ? 'success' : 'danger' %> alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-<%= locals.message.type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill' %> flex-shrink-0 fs-5"></i>
                <div><%- locals.message.text %></div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (locals.empleado) { %>
            
            <!-- 🏆 BANNER DE RECONOCIMIENTO — EMPLEADO MÁS RESPONSABLE -->
            <% if (locals.esElMasResponsable) { %>
                <div class="alert alert-warning border-0 p-3 mb-4 shadow-sm rounded-4 text-dark d-flex align-items-center gap-3" style="background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%); border-left: 5px solid #F59E0B !important;">
                    <div class="fs-1 text-warning flex-shrink-0">🏆</div>
                    <div>
                        <h5 class="fw-bold text-dark mb-1"><i class="bi bi-star-fill text-warning me-1"></i> ¡Mención de Honor: Empleado Más Responsable!</h5>
                        <p class="mb-0 small text-dark">
                            ¡Felicitaciones, <strong><%= empleado.nombre %></strong>! Has sido reconocido por la administración como el <strong>Empleado #1 en Puntualidad y Compromiso</strong> de Alimentos del Alba. ¡Gracias por tu dedicación ejemplar!
                        </p>
                    </div>
                </div>
            <% } %>

            <!-- Employee Profile Hero Card -->
            <div class="profile-header-card mb-4">
                <div class="row align-items-center g-4">
                    <div class="col-auto">
                        <div class="profile-avatar-wrapper">
                            <%
                                let profilePicSrc = '/images/default-profile-pic.png';
                                if (empleado.foto_perfil) {
                                    profilePicSrc = empleado.foto_perfil;
                                }
                            %>
                            <img src="<%- profilePicSrc %>" alt="Foto de perfil">
                        </div>
                    </div>
                    <div class="col">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h1 class="h2 fw-bold text-white mb-0"><%- empleado.nombre %> <%- empleado.apellido || '' %></h1>
                            <% if (locals.esElMasResponsable) { %>
                                <span class="badge bg-warning text-dark fw-bold fs-6"><i class="bi bi-trophy-fill me-1"></i> #1 Puntualidad</span>
                            <% } %>
                        </div>
                        <div class="d-flex flex-wrap gap-2 align-items-center text-light mt-2">
                            <span class="badge badge-alba-amber fs-6"><i class="bi bi-briefcase me-1"></i> <%- empleado.cargo || 'Empleado' %></span>
                            <span class="badge badge-alba-slate fs-6"><i class="bi bi-building me-1"></i> <%- empleado.departamento || 'General' %></span>
                            <span class="badge badge-alba-emerald fs-6"><i class="bi bi-clock me-1"></i> Turno: <%- empleado.tipo_jornada || 'Diurna (8:00 AM - 5:00 PM)' %></span>
                            <span class="text-slate-400 small ms-2"><i class="bi bi-card-heading me-1"></i> C.I: <strong><%- empleado.cedula %></strong></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content Grid -->
            <div class="row g-4">

                <!-- Left Column: QR Code -->
                <div class="col-lg-6">
                    <div class="qr-card-container h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
                                <i class="bi bi-qr-code-scan text-warning fs-3"></i>
                                <h3 class="h5 mb-0 fw-bold">Tu Código QR de Asistencia</h3>
                            </div>
                            <p class="text-muted small mb-4">Muestra este código frente al escáner de la empresa para marcar tu entrada y salida.</p>

                            <% if (locals.estadoQr && !locals.estadoQr.qrHabilitado) { %>
                                <!-- Alerta de QR Bloqueado o Pendiente -->
                                <div class="alert alert-danger text-start p-3 my-3 border-danger shadow-sm">
                                    <div class="d-flex align-items-start gap-2">
                                        <i class="bi bi-lock-fill text-danger fs-3 flex-shrink-0"></i>
                                        <div>
                                            <h6 class="fw-bold mb-1 text-danger">Código QR Temporalmente Bloqueado</h6>
                                            <p class="small mb-2 text-dark"><%= estadoQr.motivo %></p>
                                            <div class="small text-muted"><i class="bi bi-headset me-1"></i> Por favor, contacta al Administrador de planta para que registre tu salida manual y habilite tu QR de inmediato.</div>
                                        </div>
                                    </div>
                                </div>
                            <% } else if (locals.qrCodeUrl) { %>
                                <div class="qr-image-frame mb-3">
                                    <img src="<%- locals.qrCodeUrl %>" alt="Código QR de Asistencia" class="img-fluid" style="max-width: 220px;">
                                </div>
                                <div class="small text-muted mb-4"><i class="bi bi-shield-check text-success me-1"></i> Código único vinculado a la cédula <%= empleado.cedula %> (Jornada Activa)</div>
                            <% } else { %>
                                <div class="alert alert-warning my-4">No se pudo generar el código QR en este momento.</div>
                            <% } %>
                        </div>

                        <% if (locals.qrCodeUrl && locals.estadoQr && locals.estadoQr.qrHabilitado) { %>
                            <div>
                                <a href="/auth/descargar-qr-pdf" class="btn btn-alba-emerald w-100 py-2">
                                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> Descargar Carnet QR (PDF)
                                </a>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Right Column: Profile Picture Upload -->
                <div class="col-lg-6">
                    <div class="alba-card p-4 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-camera-fill text-primary fs-3"></i>
                                <h3 class="h5 mb-0 fw-bold">Actualizar Foto de Perfil</h3>
                            </div>
                            <p class="text-muted small mb-4">Sube una fotografía clara en formato JPG o PNG para identificarte en el directorio.</p>

                            <form action="/auth/empleados/perfil/upload-foto" method="POST" enctype="multipart/form-data">
                                <div class="mb-4">
                                    <label for="profilePic" class="alba-label">Seleccionar imagen</label>
                                    <input type="file" class="form-control alba-input" id="profilePic" name="profilePic" accept="image/jpeg, image/png, image/jpg" required>
                                    <div class="form-text mt-2"><i class="bi bi-shield-check text-success me-1"></i> Formatos aceptados: JPG, PNG (máx. 5MB).</div>
                                </div>
                                <button type="submit" class="btn btn-alba-primary w-100 py-2">
                                    <i class="bi bi-upload me-1"></i> Subir Nueva Foto
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

            </div>

        <% } else { %>
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-octagon-fill me-2"></i> No se pudo identificar la sesión de usuario. Por favor, vuelve a iniciar sesión.
            </div>
        <% } %>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>