<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Empleado — Alimentos del Alba</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/stylesheets/main-theme.css">
    <link rel="shortcut icon" href="/images/logo2.jpg" type="image/x-icon">
</head>
<body>

    <!-- Header Navbar -->
    <header class="alba-navbar">
        <div class="container-fluid d-flex justify-content-between align-items-center flex-wrap gap-2">
            <a href="/admin" class="navbar-brand">
                <img src="/images/logo2.jpg" alt="Logo Alba" class="brand-logo">
                <span>Alimentos del Alba <span class="badge badge-alba-amber ms-2">Admin</span></span>
            </a>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <!-- Botón Notificación Pendientes -->
                <a href="/tabGeneral?filter=pendientes" class="btn btn-sm position-relative d-inline-flex align-items-center gap-2 <%= (locals.pendientesCount && locals.pendientesCount > 0) ? 'btn-alba-warning-glow' : 'btn-outline-secondary text-light' %>" title="Usuarios pendientes por asignar jornada / activación">
                    <i class="bi bi-bell-fill <%= (locals.pendientesCount && locals.pendientesCount > 0) ? 'text-warning pulse-icon' : '' %>"></i>
                    <span class="d-none d-sm-inline font-heading">Pendientes</span>
                    <% if (locals.pendientesCount && locals.pendientesCount > 0) { %>
                        <span class="badge rounded-pill bg-danger shadow-sm badge-pulse">
                            <%= locals.pendientesCount %>
                        </span>
                    <% } else { %>
                        <span class="badge bg-secondary rounded-pill" style="font-size: 0.7rem;">0</span>
                    <% } %>
                </a>

                <a href="/tabGeneral" class="btn btn-sm btn-alba-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Volver a la Tabla
                </a>
                <a href="/auth/logout" class="btn btn-sm btn-alba-danger">
                    <i class="bi bi-box-arrow-right me-1"></i> Salir
                </a>
            </div>
        </div>
    </header>

    <main class="container my-5" style="max-width: 760px;">
        
        <div class="alba-card p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="p-3 bg-amber-light rounded-3 text-warning fs-3" style="background: var(--primary-light);">
                    <i class="bi bi-pencil-square text-warning"></i>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1">Editar Empleado & Tipo de Jornada</h1>
                    <p class="text-muted small mb-0">Actualiza los datos del perfil ID: <strong>#<%= empleado.id %></strong></p>
                </div>
            </div>

            <form action="/updateempleado/<%= empleado.id %>" method="POST">
                <div class="row g-3">

                    <!-- Usuario -->
                    <div class="col-md-6">
                        <label for="usuario" class="alba-label">Usuario</label>
                        <input type="text" id="usuario" name="usuario" class="form-control alba-input" value="<%= empleado.usuario %>" required>
                    </div>

                    <!-- Cédula -->
                    <div class="col-md-6">
                        <label for="cedula" class="alba-label">Cédula</label>
                        <input type="number" id="cedula" name="cedula" class="form-control alba-input" value="<%= empleado.cedula %>" required>
                    </div>

                    <!-- Nombre -->
                    <div class="col-md-6">
                        <label for="nombre" class="alba-label">Nombre</label>
                        <input type="text" id="nombre" name="nombre" class="form-control alba-input" value="<%= empleado.nombre %>" required>
                    </div>

                    <!-- Apellido -->
                    <div class="col-md-6">
                        <label for="apellido" class="alba-label">Apellido</label>
                        <input type="text" id="apellido" name="apellido" class="form-control alba-input" value="<%= empleado.apellido %>" required>
                    </div>

                    <!-- Cargo -->
                    <div class="col-md-6">
                        <label for="cargo" class="alba-label">Cargo</label>
                        <input type="text" id="cargo" name="cargo" class="form-control alba-input" value="<%= empleado.cargo %>" required>
                    </div>

                    <!-- Departamento -->
                    <div class="col-md-6">
                        <label for="departamento" class="alba-label">Departamento</label>
                        <input type="text" id="departamento" name="departamento" class="form-control alba-input" value="<%= empleado.departamento %>" required>
                    </div>

                    <!-- Teléfono -->
                    <div class="col-md-6">
                        <label for="telefono" class="alba-label">Teléfono</label>
                        <input type="number" id="telefono" name="telefono" class="form-control alba-input" value="<%= empleado.telefono %>" required>
                    </div>

                    <!-- Correo -->
                    <div class="col-md-6">
                        <label for="correo" class="alba-label">Correo Electrónico</label>
                        <input type="email" id="correo" name="correo" class="form-control alba-input" value="<%= empleado.correo %>" required>
                    </div>

                    <!-- Tipo de Jornada & Días (Entrada Manual de Texto Libre) -->
                    <div class="col-md-12">
                        <label for="tipo_jornada" class="alba-label fw-bold text-primary">
                            <i class="bi bi-clock-history me-1"></i> Tipo de Jornada y Días de Trabajo *
                        </label>
                        <input type="text" 
                               id="tipo_jornada" 
                               name="tipo_jornada" 
                               class="form-control alba-input" 
                               placeholder="Ej. Lunes a Viernes (8:00 AM - 5:00 PM) | Sábados (8:00 AM - 12:00 PM)" 
                               value="<%= empleado.tipo_jornada || '' %>" 
                               required>
                        <div class="form-text small text-muted mt-1">
                            <i class="bi bi-info-circle me-1"></i> Escribe libremente los días y el horario (ej. <em>Lunes a Viernes (8:00 AM - 5:00 PM)</em>, <em>Lunes a Domingos (7:00 AM - 3:00 PM)</em>, etc.).
                        </div>
                    </div>

                    <!-- Estatus del Empleado -->
                    <div class="col-md-12">
                        <label for="estatus_empleado" class="alba-label fw-bold text-danger">
                            <i class="bi bi-person-check me-1"></i> Estatus del Empleado (Controla acceso al QR)
                        </label>
                        <select id="estatus_empleado" name="estatus_empleado" class="form-select alba-input" required>
                            <option value="Activo"          <%= (empleado.estatus_empleado === 'Activo'          || !empleado.estatus_empleado) ? 'selected' : '' %>>✅ Activo</option>
                            <option value="De Vacaciones"   <%= (empleado.estatus_empleado === 'De Vacaciones')   ? 'selected' : '' %>>🏖️ De Vacaciones</option>
                            <option value="En Reposo Médico"<%= (empleado.estatus_empleado === 'En Reposo Médico') ? 'selected' : '' %>>🏥 En Reposo Médico</option>
                            <option value="Permiso Especial"<%= (empleado.estatus_empleado === 'Permiso Especial') ? 'selected' : '' %>>📋 Permiso Especial</option>
                            <option value="Suspendido"      <%= (empleado.estatus_empleado === 'Suspendido')      ? 'selected' : '' %>>🚫 Suspendido</option>
                            <option value="Baja Temporal"   <%= (empleado.estatus_empleado === 'Baja Temporal')   ? 'selected' : '' %>>⏸️ Baja Temporal</option>
                            <option value="Inactivo"        <%= (empleado.estatus_empleado === 'Inactivo')        ? 'selected' : '' %>>🔴 Inactivo</option>
                        </select>
                        <div class="form-text small mt-1 text-success">
                            <i class="bi bi-shield-check me-1"></i> Solo empleados con estatus <strong>Activo</strong> y jornada asignada pueden escanear su QR de asistencia.
                        </div>
                    </div>

                    <!-- Detalle del Estatus (Fechas y Observación) — visible solo si no es Activo -->
                    <div id="detalle-estatus-container" class="col-md-12 <%= (empleado.estatus_empleado && empleado.estatus_empleado !== 'Activo') ? '' : 'd-none' %>">
                        <div class="card border-warning-subtle bg-warning-subtle p-3 mt-1">
                            <p class="small fw-bold text-warning-emphasis mb-2">
                                <i class="bi bi-calendar-range me-1"></i> Período del Estatus
                            </p>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label for="estatus_desde" class="alba-label small">Fecha Inicio *</label>
                                    <input type="date" id="estatus_desde" name="estatus_desde" class="form-control alba-input"
                                           value="<%= empleado.estatus_desde || '' %>">
                                    <div class="form-text small">Desde cuándo aplica el estatus.</div>
                                </div>
                                <div class="col-md-4">
                                    <label for="estatus_hasta" class="alba-label small">Fecha de Retorno Estimada</label>
                                    <input type="date" id="estatus_hasta" name="estatus_hasta" class="form-control alba-input"
                                           value="<%= empleado.estatus_hasta || '' %>">
                                    <div class="form-text small">Hasta cuándo dura (opcional).</div>
                                </div>
                                <div class="col-md-4">
                                    <label for="estatus_observacion" class="alba-label small">Motivo / Observación</label>
                                    <input type="text" id="estatus_observacion" name="estatus_observacion" class="form-control alba-input"
                                           placeholder="Ej. Reposo por fractura de tobillo, constancia médica entregada"
                                           value="<%= empleado.estatus_observacion || '' %>">
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a href="/tabGeneral" class="btn btn-alba-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-alba-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Actualizar Empleado
                    </button>
                </div>
            </form>
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const selectEstatus = document.getElementById('estatus_empleado');
        const detalleEstatus = document.getElementById('detalle-estatus-container');

        function toggleDetalleEstatus() {
            if (selectEstatus.value && selectEstatus.value !== 'Activo') {
                detalleEstatus.classList.remove('d-none');
            } else {
                detalleEstatus.classList.add('d-none');
                // Limpiar campos si vuelven a Activo
                document.getElementById('estatus_desde').value = '';
                document.getElementById('estatus_hasta').value = '';
                document.getElementById('estatus_observacion').value = '';
            }
        }

        selectEstatus.addEventListener('change', toggleDetalleEstatus);
    </script>
</body>
</html>