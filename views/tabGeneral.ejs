<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Directorio de Empleados — Alimentos del Alba</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/stylesheets/main-theme.css">
    <link rel="shortcut icon" href="/images/logo2.jpg" type="image/x-icon">
</head>
<body>

    <!-- Header Navbar -->
    <header class="alba-navbar">
        <div class="container-fluid d-flex justify-content-between align-items-center flex-wrap gap-2">
            <a href="/admin" class="navbar-brand">
                <img src="/images/logo2.jpg" alt="Logo Alba" class="brand-logo">
                <span>Alimentos del Alba <span class="badge badge-alba-amber ms-2">Admin</span></span>
            </a>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <!-- Botón Notificación Pendientes -->
                <a href="/tabGeneral?filter=pendientes" class="btn btn-sm position-relative d-inline-flex align-items-center gap-2 <%= (locals.pendientesCount && locals.pendientesCount > 0) ? 'btn-alba-warning-glow' : 'btn-outline-secondary text-light' %>" title="Usuarios pendientes por asignar jornada / activación">
                    <i class="bi bi-bell-fill <%= (locals.pendientesCount && locals.pendientesCount > 0) ? 'text-warning pulse-icon' : '' %>"></i>
                    <span class="d-none d-sm-inline font-heading">Pendientes</span>
                    <% if (locals.pendientesCount && locals.pendientesCount > 0) { %>
                        <span class="badge rounded-pill bg-danger shadow-sm badge-pulse">
                            <%= locals.pendientesCount %>
                        </span>
                    <% } else { %>
                        <span class="badge bg-secondary rounded-pill" style="font-size: 0.7rem;">0</span>
                    <% } %>
                </a>

                <a href="/admin" class="btn btn-sm btn-alba-secondary">
                    <i class="bi bi-house me-1"></i> Menú Admin
                </a>
                <a href="/auth/logout" class="btn btn-sm btn-alba-danger">
                    <i class="bi bi-box-arrow-right me-1"></i> Salir
                </a>
            </div>
        </div>
    </header>

    <!-- Toast Notification Container -->
    <% if (locals.message && locals.message.text) { %>
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
            <div id="albaToast" class="toast align-items-center text-white bg-<%= locals.message.type === 'success' ? 'success' : 'danger' %> border-0 show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center gap-2">
                        <i class="bi bi-<%= locals.message.type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill' %> fs-5"></i>
                        <div><%- locals.message.text %></div>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    <% } %>

    <main class="container my-4">
        
        <!-- Header Banner & Stats Badges -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1"><i class="bi bi-people text-warning me-2"></i> Directorio de Empleados</h1>
                <p class="text-muted mb-0">Gestión de personal y asignación de <strong>Tipo de Jornada</strong> para activación de código QR.</p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="badge badge-alba-amber fs-6 px-3 py-2" id="badge-count">
                    <i class="bi bi-person-fill me-1"></i> Total: <%= (empleados && empleados.length) ? empleados.length : 0 %>
                </span>
                <span class="badge badge-alba-emerald fs-6 px-3 py-2">
                    <i class="bi bi-qr-code me-1"></i> <%= (locals.stats && locals.stats.qrHabilitados) ? locals.stats.qrHabilitados : 0 %> Activos
                </span>
                <% const countPendientes = (locals.stats && locals.stats.pendientesJornada !== undefined) ? locals.stats.pendientesJornada : (locals.pendientesCount || 0); %>
                <span class="badge <%= countPendientes > 0 ? 'bg-danger text-white animate-pulse-badge' : 'bg-secondary text-white' %> fs-6 px-3 py-2" id="badge-pending">
                    <i class="bi bi-bell-fill me-1"></i> <%= countPendientes %> Pendientes
                </span>
            </div>
        </div>

        <!-- Toolbar & Filter -->
        <div class="alba-card p-3 mb-4">
            <div class="row g-3 align-items-center">
                <div class="col-lg-6 col-md-7">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="input-search" class="form-control border-start-0 ps-0" placeholder="Buscar por nombre, cédula, cargo, departamento o tipo de jornada...">
                    </div>
                </div>
                <div class="col-lg-4 col-md-5 d-flex gap-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary flex-fill filter-btn active" data-filter="all">Todos</button>
                    <button type="button" class="btn btn-sm btn-outline-success flex-fill filter-btn" data-filter="activos">Activos</button>
                    <button type="button" class="btn btn-sm btn-outline-warning flex-fill filter-btn" data-filter="pendientes">
                        ⚠️ Pendientes (<%= countPendientes %>)
                    </button>
                </div>
                <div class="col-lg-2 col-md-12 text-lg-end">
                    <button type="button" class="btn btn-alba-emerald w-100 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNuevoEmpleado">
                        <i class="bi bi-person-plus-fill me-1"></i> Registrar Empleado
                    </button>
                </div>
            </div>
        </div>

        <!-- Employee Table Container -->
        <div class="alba-table-container shadow-md">
            <table class="alba-table" id="tabla-general">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Empleado / Correo</th>
                        <th>Usuario</th>
                        <th>Cédula</th>
                        <th>Cargo / Dpto</th>
                        <th>Tipo de Jornada</th>
                        <th>Estado QR</th>
                        <th class="text-center" style="width: 140px;">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbody-general">
                    <% if (empleados && empleados.length > 0) { %>
                        <% empleados.forEach((empleado, index) => { %>
                            <% const esPendiente = !empleado.tipo_jornada || empleado.tipo_jornada.trim() === '' || empleado.tipo_jornada === 'Pendiente' || (empleado.estatus_empleado && empleado.estatus_empleado !== 'Activo'); %>
                            <tr data-empleado-id="<%= empleado.id %>" data-status="<%= esPendiente ? 'pendiente' : 'activo' %>" class="<%= esPendiente ? 'alba-tr-warning' : '' %>">
                                <td class="fw-bold text-muted"><%= index + 1 %></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle <%= esPendiente ? 'bg-amber-light text-amber border-amber' : 'bg-light text-slate-700' %> d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 40px; height: 40px; font-weight: 700;">
                                            <% if (empleado.foto_perfil) { %>
                                                <img src="<%= empleado.foto_perfil %>" alt="Avatar" class="rounded-circle w-100 h-100 object-fit-cover">
                                            <% } else { %>
                                                <%= empleado.nombre ? empleado.nombre.charAt(0).toUpperCase() : 'E' %>
                                            <% } %>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark"><%= empleado.nombre %> <%= empleado.apellido || '' %></div>
                                            <small class="text-muted text-break" style="font-size: 0.8rem;"><%= empleado.correo || 'Sin correo' %></small>
                                        </div>
                                    </div>
                                </td>
                                <td><code class="text-primary fw-semibold"><%= empleado.usuario %></code></td>
                                <td><span class="fw-semibold text-dark">V-<%= empleado.cedula %></span></td>
                                <td>
                                    <div><span class="badge badge-alba-amber"><%= empleado.cargo || 'General' %></span></div>
                                    <small class="text-muted"><%= empleado.departamento || 'Planta' %></small>
                                </td>
                                <td>
                                    <% if (!esPendiente) { %>
                                        <span class="badge badge-alba-slate fw-medium">
                                            <i class="bi bi-clock me-1"></i><%= empleado.tipo_jornada %>
                                        </span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark fw-bold">
                                            <i class="bi bi-exclamation-triangle me-1"></i> Sin Jornada Asignada
                                        </span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (!esPendiente) { %>
                                        <span class="badge badge-alba-emerald"><i class="bi bi-qr-code-scan me-1"></i> QR Habilitado</span>
                                    <% } else { %>
                                        <span class="badge bg-danger text-white badge-pulse"><i class="bi bi-bell-fill me-1"></i> Pendiente Activación</span>
                                    <% } %>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/editempleado/<%= empleado.id %>" class="btn <%= esPendiente ? 'btn-amber-action' : 'btn-outline-primary' %>" title="<%= esPendiente ? '¡Asignar Jornada para Activar QR!' : 'Editar Empleado' %>">
                                            <i class="bi bi-pencil-square me-1"></i><%= esPendiente ? 'Asignar' : '' %>
                                        </a>
                                        <button class="btn btn-outline-danger btn-eliminar" data-id="<%= empleado.id %>" title="Eliminar Empleado">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-warning"></i>
                                No hay empleados registrados actualmente.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

    </main>

    <!-- Modal Registrar Nuevo Empleado (ADMINISTRATIVO CON TODOS LOS CAMPOS) -->
    <div class="modal fade" id="modalNuevoEmpleado" tabindex="-1" aria-labelledby="modalNuevoEmpleadoLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white border-bottom border-warning border-3">
                    <h5 class="modal-title font-heading fw-bold" id="modalNuevoEmpleadoLabel">
                        <i class="bi bi-person-plus-fill text-warning me-2"></i> Registrar Empleado (Panel Administrativo)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/guardarEmpleado" method="POST">
                    <div class="modal-body p-4">
                        
                        <!-- SECCIÓN 1: DATOS PERSONALES -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-success border-bottom pb-2 mb-3">
                                <i class="bi bi-person-vcard me-1"></i> 1. Información Personal
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="admin_nombre" class="form-label small fw-bold">Nombre *</label>
                                    <input type="text" id="admin_nombre" name="nombre" class="form-control" placeholder="Ej. Carlos" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="admin_apellido" class="form-label small fw-bold">Apellido *</label>
                                    <input type="text" id="admin_apellido" name="apellido" class="form-control" placeholder="Ej. Mendoza" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="admin_cedula" class="form-label small fw-bold">Cédula de Identidad *</label>
                                    <div class="input-group">
                                        <span class="input-group-text">V-</span>
                                        <input type="number" id="admin_cedula" name="cedula" class="form-control" placeholder="Ej. 12345678" required>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label for="admin_telefono" class="form-label small fw-bold">Teléfono *</label>
                                    <input type="number" id="admin_telefono" name="telefono" class="form-control" placeholder="Ej. 04141234567" required>
                                </div>
                            </div>
                        </div>

                        <!-- SECCIÓN 2: INFORMACIÓN LABORAL Y ASIGNACIÓN DE JORNADA -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-amber border-bottom pb-2 mb-3">
                                <i class="bi bi-briefcase-fill me-1"></i> 2. Cargo, Jornada y Estatus Inicial
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="admin_cargo" class="form-label small fw-bold">Cargo *</label>
                                    <input type="text" id="admin_cargo" name="cargo" class="form-control" placeholder="Ej. Operador de Planta" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="admin_departamento" class="form-label small fw-bold">Departamento *</label>
                                    <input type="text" id="admin_departamento" name="departamento" class="form-control" placeholder="Ej. Producción" required>
                                </div>
                                <div class="col-md-12">
                                    <label for="admin_tipo_jornada" class="form-label small fw-bold text-primary">
                                        <i class="bi bi-clock-history me-1"></i> Tipo de Jornada y Días de Trabajo *
                                    </label>
                                    <input type="text" id="admin_tipo_jornada" name="tipo_jornada" class="form-control" placeholder="Ej. Lunes a Viernes (8:00 AM - 5:00 PM)" value="Lunes a Viernes (8:00 AM - 5:00 PM)" required>
                                    <div class="form-text small text-muted">
                                        Asigna el horario para habilitar el Código QR de marcaje del empleado de inmediato.
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <label for="admin_estatus_empleado" class="form-label small fw-bold text-danger">
                                        <i class="bi bi-person-check me-1"></i> Estatus Inicial del Empleado *
                                    </label>
                                    <select id="admin_estatus_empleado" name="estatus_empleado" class="form-select" required>
                                        <option value="Activo" selected>✅ Activo (QR Habilitado de inmediato)</option>
                                        <option value="De Vacaciones">🏖️ De Vacaciones</option>
                                        <option value="En Reposo Médico">🏥 En Reposo Médico</option>
                                        <option value="Permiso Especial">📋 Permiso Especial</option>
                                        <option value="Suspendido">🚫 Suspendido</option>
                                        <option value="Baja Temporal">⏸️ Baja Temporal</option>
                                        <option value="Inactivo">🔴 Inactivo</option>
                                    </select>
                                </div>

                                <!-- Detalle del Estatus (Fechas y Observación) -->
                                <div id="modal-detalle-estatus" class="col-md-12 d-none">
                                    <div class="card border-warning-subtle bg-warning-subtle p-3">
                                        <p class="small fw-bold text-warning-emphasis mb-2">
                                            <i class="bi bi-calendar-range me-1"></i> Período del Estatus Específico
                                        </p>
                                        <div class="row g-2">
                                            <div class="col-md-4">
                                                <label for="admin_estatus_desde" class="form-label small">Desde</label>
                                                <input type="date" id="admin_estatus_desde" name="estatus_desde" class="form-control form-control-sm">
                                            </div>
                                            <div class="col-md-4">
                                                <label for="admin_estatus_hasta" class="form-label small">Hasta</label>
                                                <input type="date" id="admin_estatus_hasta" name="estatus_hasta" class="form-control form-control-sm">
                                            </div>
                                            <div class="col-md-4">
                                                <label for="admin_estatus_observacion" class="form-label small">Motivo / Observación</label>
                                                <input type="text" id="admin_estatus_observacion" name="estatus_observacion" class="form-control form-control-sm" placeholder="Ej. Reposo médico entregado">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- SECCIÓN 3: CREDENCIALES DE ACCESO -->
                        <div>
                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                                <i class="bi bi-shield-lock-fill me-1"></i> 3. Credenciales de Cuenta y Acceso
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label for="admin_usuario" class="form-label small fw-bold">Usuario *</label>
                                    <input type="text" id="admin_usuario" name="usuario" class="form-control" placeholder="Ej. cmendoza" required>
                                </div>
                                <div class="col-md-4">
                                    <label for="admin_correo" class="form-label small fw-bold">Correo Electrónico *</label>
                                    <input type="email" id="admin_correo" name="correo" class="form-control" placeholder="carlos@alimentosdelalba.com" required>
                                </div>
                                <div class="col-md-4">
                                    <label for="admin_password" class="form-label small fw-bold">Contraseña *</label>
                                    <input type="password" id="admin_password" name="password" class="form-control" placeholder="••••••••" required>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-alba-emerald px-4">
                            <i class="bi bi-check-circle-fill me-1"></i> Registrar Empleado Completo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const inputSearch = document.getElementById('input-search');
            const tbody = document.getElementById('tbody-general');
            const rows = tbody.querySelectorAll('tr[data-empleado-id]');
            const filterBtns = document.querySelectorAll('.filter-btn');

            let currentFilter = 'all';

            // Comprobar parámetro en la URL (?filter=pendientes)
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('filter') === 'pendientes') {
                currentFilter = 'pendientes';
                filterBtns.forEach(btn => {
                    btn.classList.toggle('active', btn.dataset.filter === 'pendientes');
                });
            }

            function applyFilter() {
                const query = inputSearch ? inputSearch.value.toLowerCase().trim() : '';
                rows.forEach(row => {
                    const status = row.dataset.status;
                    const text = row.textContent.toLowerCase();
                    
                    let matchesFilter = true;
                    if (currentFilter === 'pendientes') {
                        matchesFilter = (status === 'pendiente');
                    } else if (currentFilter === 'activos') {
                        matchesFilter = (status === 'activo');
                    }

                    const matchesSearch = text.includes(query);

                    if (matchesFilter && matchesSearch) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            // Toast Auto-Show
            const toastEl = document.getElementById('albaToast');
            if (toastEl) {
                const toast = new bootstrap.Toast(toastEl, { delay: 4500 });
                toast.show();
            }

            // Evento búsqueda
            if (inputSearch) {
                inputSearch.addEventListener('input', applyFilter);
            }

            // Botones de filtro rápido
            filterBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    currentFilter = this.dataset.filter;
                    applyFilter();
                });
            });

            // Aplicar filtro inicial
            applyFilter();

            // Eliminación mediante POST
            const botonesEliminar = document.querySelectorAll('.btn-eliminar');
            botonesEliminar.forEach(boton => {
                boton.addEventListener('click', function(event) {
                    event.preventDefault();
                    const empleadoId = this.dataset.id;
                    const rowToDelete = this.closest('tr');

                    if (!confirm('¿Estás seguro de que deseas eliminar este empleado?')) {
                        return;
                    }

                    fetch(`/deleteempleado/${empleadoId}`, { method: 'POST' })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                if (rowToDelete) {
                                    rowToDelete.remove();
                                    const remainingRows = tbody.querySelectorAll('tr[data-empleado-id]');
                                    remainingRows.forEach((row, index) => {
                                        row.querySelector('td:first-child').textContent = index + 1;
                                    });
                                    const badgeCount = document.getElementById('badge-count');
                                    if (badgeCount) {
                                        badgeCount.innerHTML = `<i class="bi bi-person-fill me-1"></i> Total: ${remainingRows.length}`;
                                    }
                                }
                            } else {
                                alert('Error al eliminar empleado: ' + (data.error || 'Error indeterminado'));
                            }
                        })
                        .catch(error => {
                            console.error('Error en la solicitud de eliminación:', error);
                            alert('Error de conexión al intentar eliminar.');
                        });
                });
            });

            // Toggle detalle de estatus en Modal Administrativo
            const selectEstatusAdmin = document.getElementById('admin_estatus_empleado');
            const detalleEstatusAdmin = document.getElementById('modal-detalle-estatus');
            if (selectEstatusAdmin && detalleEstatusAdmin) {
                selectEstatusAdmin.addEventListener('change', function() {
                    if (this.value && this.value !== 'Activo') {
                        detalleEstatusAdmin.classList.remove('d-none');
                    } else {
                        detalleEstatusAdmin.classList.add('d-none');
                    }
                });
            }
        });
    </script>
</body>
</html>