<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acceso Administrativo — Alimentos del Alba</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/stylesheets/main-theme.css">
    <link rel="shortcut icon" href="/images/logo2.jpg" type="image/x-icon">
</head>
<body class="login-page-body">

    <div class="login-card">
        <div class="brand-header">
            <img src="/images/logo2.jpg" alt="Alimentos del Alba Logo">
            <h2 class="h3 fw-bold text-dark mb-1">Panel de Control Admin</h2>
            <p class="text-muted small">Alimentos del Alba C.A.</p>
        </div>

        <% if (locals.logout === 'success') { %>
            <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                <div>Has cerrado sesión administrativamente de manera exitosa. ¡Hasta pronto!</div>
            </div>
        <% } else if (locals.error === 'incorrectCredentials') { %>
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>Credenciales incorrectas. Verifica tu usuario o contraseña.</div>
            </div>
        <% } else if (locals.error === 'tooManyAttempts') { %>
            <div class="alert alert-warning d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-shield-exclamation flex-shrink-0"></i>
                <div>Demasiados intentos fallidos. Reintenta en 15 minutos.</div>
            </div>
        <% } %>

        <form action="/login" method="POST">
            <div class="mb-3">
                <label for="user" class="alba-label">Nombre de Usuario</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                    <input type="text" id="user" name="user" class="form-control border-start-0 ps-0" placeholder="Ej. admin" required autofocus>
                </div>
            </div>

            <div class="mb-4">
                <label for="password" class="alba-label">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                    <input type="password" id="password" name="password" class="form-control border-start-0 ps-0" placeholder="••••••••" required>
                </div>
            </div>

            <button type="submit" class="btn btn-alba-primary w-100 py-2 mb-3">
                <i class="bi bi-box-arrow-in-right"></i> Acceder al Sistema
            </button>

            <div class="text-center mt-3">
                <a href="/" class="text-decoration-none text-muted small hover-primary">
                    <i class="bi bi-arrow-left"></i> Volver a la página principal
                </a>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>