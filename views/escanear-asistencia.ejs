<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Escáner QR de Asistencia — Alimentos del Alba</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/stylesheets/main-theme.css">
    <link rel="shortcut icon" href="/images/logo2.jpg" type="image/x-icon">
</head>
<body>

    <!-- Header Navbar -->
    <header class="alba-navbar">
        <div class="container-fluid d-flex justify-content-between align-items-center flex-wrap gap-2">
            <a href="/admin" class="navbar-brand">
                <img src="/images/logo2.jpg" alt="Logo Alba" class="brand-logo">
                <span>Alimentos del Alba</span>
            </a>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <% if (locals.isAdmin) { %>
                    <a href="/tabGeneral?filter=pendientes" class="btn btn-sm position-relative d-inline-flex align-items-center gap-2 <%= (locals.pendientesCount && locals.pendientesCount > 0) ? 'btn-alba-warning-glow' : 'btn-outline-secondary text-light' %>" title="Usuarios pendientes por asignar jornada / activación">
                        <i class="bi bi-bell-fill <%= (locals.pendientesCount && locals.pendientesCount > 0) ? 'text-warning pulse-icon' : '' %>"></i>
                        <span class="d-none d-sm-inline font-heading">Pendientes</span>
                        <% if (locals.pendientesCount && locals.pendientesCount > 0) { %>
                            <span class="badge rounded-pill bg-danger shadow-sm badge-pulse">
                                <%= locals.pendientesCount %>
                            </span>
                        <% } else { %>
                            <span class="badge bg-secondary rounded-pill" style="font-size: 0.7rem;">0</span>
                        <% } %>
                    </a>
                <% } %>
                <a href="/admin" class="btn btn-sm btn-alba-secondary">
                    <i class="bi bi-house me-1"></i> Menú Admin
                </a>
            </div>
        </div>
    </header>

    <main class="container my-5">

        <div class="scanner-card">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                <i class="bi bi-qr-code-scan text-warning fs-2"></i>
                <h1 class="h3 fw-bold mb-0">Escáner de Asistencia Inteligente</h1>
            </div>
            <p class="text-muted small mb-4">Apunta la cámara del dispositivo al código QR del carnet del empleado.</p>

            <div id="scan-button-container">
                <button id="start-scan-button" class="btn btn-alba-primary py-3 px-4 fs-5 w-100">
                    <i class="bi bi-camera-video-fill me-2"></i> Activar Cámara e Iniciar Escaneo
                </button>
            </div>

            <div id="video-container">
                <video id="video" playsinline></video>
                <div class="scanner-overlay"></div>
            </div>
            
            <canvas id="canvas"></canvas>

            <div id="resultado" class="alert alert-info d-none" role="alert"></div>

            <div id="employee-info-card" class="d-none"></div>

            <div id="action-buttons" class="mt-3">
                <button id="registrar-entrada-button" class="btn btn-alba-emerald w-100 py-2.5 fs-5 mb-2 d-none">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Confirmar y Registrar Entrada
                </button>
                <button id="registrar-salida-button" class="btn btn-alba-primary w-100 py-2.5 fs-5 mb-2 d-none">
                    <i class="bi bi-box-arrow-right me-2"></i> Confirmar y Registrar Salida
                </button>
                <button id="reiniciar-scan-button" class="btn btn-alba-secondary w-100 py-2 d-none">
                    <i class="bi bi-arrow-repeat me-1"></i> Escanear Otro Código
                </button>
            </div>
        </div>

    </main>

    <!-- Modal de Justificación si está Fuera de Horario -->
    <div class="modal fade" id="modalJustificacionEscaneo" tabindex="-1" aria-labelledby="modalJustificacionEscaneoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header bg-warning text-dark rounded-top-4">
                    <h5 class="modal-title h6 fw-bold" id="modalJustificacionEscaneoLabel">
                        <i class="bi bi-clock-history me-2"></i> Justificación de Marcaje Fuera de Horario
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-start">
                    <div id="modal-justificacion-alerta" class="alert alert-warning small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Estás marcando fuera de tu horario asignado. Por favor ingresa el motivo.
                    </div>
                    <div class="mb-3">
                        <label for="input-observacion-escaneo" class="alba-label small fw-bold text-dark">Motivo / Justificación del Marcaje *</label>
                        <textarea id="input-observacion-escaneo" class="form-control alba-input" rows="3"
                                  placeholder="Ej: Llegada con retraso por transporte público, permiso médico autorizado, tiempo extra otorgado por supervisión..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4 border-top">
                    <button type="button" class="btn btn-alba-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="btn-guardar-justificacion" class="btn btn-alba-primary">
                        <i class="bi bi-check-circle-fill me-1"></i> Guardar Marcaje con Justificación
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
    <script>
        const video = document.getElementById('video');
        const videoContainer = document.getElementById('video-container');
        const canvas = document.getElementById('canvas');
        const resultadoDiv = document.getElementById('resultado');
        const employeeCardDiv = document.getElementById('employee-info-card');
        const canvasContext = canvas.getContext('2d');
        const startScanButton = document.getElementById('start-scan-button');
        const actionButtonsDiv = document.getElementById('action-buttons');
        const registrarEntradaButton = document.getElementById('registrar-entrada-button');
        const registrarSalidaButton = document.getElementById('registrar-salida-button');
        const reiniciarScanButton = document.getElementById('reiniciar-scan-button');

        let scanning = false;
        let scannedCode = null;
        let currentScanData = null;
        let pendingActionType = null;
        let modalJustificacionBs = null;

        document.addEventListener('DOMContentLoaded', () => {
            modalJustificacionBs = new bootstrap.Modal(document.getElementById('modalJustificacionEscaneo'));
        });

        // Reproductor de efectos de sonido con Web Audio API
        function playBeep(type = 'success') {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                if (type === 'success') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(880, audioCtx.currentTime);
                    gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.25);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.25);
                } else {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(280, audioCtx.currentTime);
                    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.35);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.35);
                }
            } catch (e) {
                console.log('Audio feedback not available:', e);
            }
        }

        function mostrarMensaje(texto, tipo = 'info') {
            resultadoDiv.className = `alert alert-${tipo} mt-3 d-block`;
            resultadoDiv.innerHTML = texto;
        }

        function ocultarMensaje() {
            resultadoDiv.className = 'd-none';
        }

        startScanButton.addEventListener('click', () => {
            resetScanner();
            startScan();
            startScanButton.parentElement.style.display = 'none';
            videoContainer.style.display = 'block';
        });

        reiniciarScanButton.addEventListener('click', () => {
            resetScanner();
            startScan();
            startScanButton.parentElement.style.display = 'none';
            videoContainer.style.display = 'block';
        });

        function resetScanner() {
            scannedCode = null;
            currentScanData = null;
            pendingActionType = null;
            ocultarMensaje();
            employeeCardDiv.className = 'd-none';
            employeeCardDiv.innerHTML = '';
            actionButtonsDiv.style.display = 'none';
            registrarEntradaButton.classList.add('d-none');
            registrarSalidaButton.classList.add('d-none');
            reiniciarScanButton.classList.add('d-none');
        }

        // Evalúa si la hora actual está fuera de la jornada asignada
        function evaluarFueraDeHorario(tipoJornada, esSalida) {
            if (!tipoJornada) return { fueraDeHora: false };

            const now = new Date();
            const currentMinutes = now.getHours() * 60 + now.getMinutes();

            // Buscar horas en formato hh:mm (ej: 8:00 AM - 5:00 PM)
            const matches = tipoJornada.match(/(\d{1,2}):(\d{2})\s*(AM|PM|am|pm)?/g);
            if (!matches || matches.length < 2) {
                return { fueraDeHora: false };
            }

            const parseTimeToMinutes = (str) => {
                const parts = str.match(/(\d{1,2}):(\d{2})\s*(AM|PM|am|pm)?/i);
                if (!parts) return null;
                let hrs = parseInt(parts[1]);
                const mins = parseInt(parts[2]);
                const ampm = parts[3] ? parts[3].toUpperCase() : null;

                if (ampm === 'PM' && hrs < 12) hrs += 12;
                if (ampm === 'AM' && hrs === 12) hrs = 0;

                return hrs * 60 + mins;
            };

            const startMins = parseTimeToMinutes(matches[0]);
            const endMins = parseTimeToMinutes(matches[1]);

            if (startMins === null || endMins === null) return { fueraDeHora: false };

            if (!esSalida) {
                // Entrada: toleramos hasta 15 min de retraso
                if (currentMinutes > startMins + 15) {
                    const diff = currentMinutes - startMins;
                    return {
                        fueraDeHora: true,
                        mensaje: `Estás marcando Entrada con ${diff} minutos de retraso respecto a tu turno regular [${matches[0]}].`
                    };
                }
            } else {
                // Salida: si sale antes de la hora de fin (tolerancia 15 min)
                if (currentMinutes < endMins - 15) {
                    const diff = endMins - currentMinutes;
                    return {
                        fueraDeHora: true,
                        mensaje: `Estás marcando Salida ${diff} minutos antes de finalizar tu jornada regular [${matches[1]}].`
                    };
                }
            }

            return { fueraDeHora: false };
        }

        function manejarClickAccion(tipo) {
            if (!scannedCode) {
                mostrarMensaje('<i class="bi bi-exclamation-triangle me-1"></i> No se ha detectado un código QR válido.', 'warning');
                return;
            }

            pendingActionType = tipo;
            const jornada = currentScanData && currentScanData.empleado ? currentScanData.empleado.tipo_jornada : '';
            const evaluacion = evaluarFueraDeHorario(jornada, tipo === 'salida');

            if (evaluacion.fueraDeHora) {
                document.getElementById('modal-justificacion-alerta').innerHTML = `
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>Atención:</strong> ${evaluacion.mensaje}
                `;
                document.getElementById('input-observacion-escaneo').value = '';
                modalJustificacionBs.show();
            } else {
                registrarAsistencia(tipo, scannedCode, null);
            }
        }

        registrarEntradaButton.addEventListener('click', () => manejarClickAccion('entrada'));
        registrarSalidaButton.addEventListener('click', () => manejarClickAccion('salida'));

        document.getElementById('btn-guardar-justificacion').addEventListener('click', () => {
            const obsInput = document.getElementById('input-observacion-escaneo').value.trim();
            modalJustificacionBs.hide();
            registrarAsistencia(pendingActionType, scannedCode, obsInput || 'Marcaje fuera de horario asignado');
        });

        function startScan() {
            scanning = true;
            navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } })
                .then(function(stream) {
                    video.srcObject = stream;
                    video.setAttribute('playsinline', true);
                    video.play();
                    requestAnimationFrame(scanQRCode);
                })
                .catch(function(err) {
                    mostrarMensaje('<i class="bi bi-camera-video-off me-1"></i> Error al acceder a la cámara: ' + err.message, 'danger');
                    startScanButton.parentElement.style.display = 'block';
                    videoContainer.style.display = 'none';
                });
        }

        function stopScan() {
            scanning = false;
            if (video.srcObject) {
                const stream = video.srcObject;
                const tracks = stream.getTracks();
                tracks.forEach(track => track.stop());
                video.srcObject = null;
            }
        }

        function scanQRCode() {
            if (!scanning) return;

            if (video.readyState === video.HAVE_ENOUGH_DATA) {
                canvas.height = video.videoHeight;
                canvas.width = video.videoWidth;
                canvasContext.drawImage(video, 0, 0, canvas.width, canvas.height);
                const imageData = canvasContext.getImageData(0, 0, canvas.width, canvas.height);
                const code = jsQR(imageData.data, imageData.width, imageData.height);

                if (code) {
                    stopScan();
                    scannedCode = code.data;
                    videoContainer.style.display = 'none';
                    consultarEstadoEscaneo(scannedCode);
                } else {
                    requestAnimationFrame(scanQRCode);
                }
            } else {
                requestAnimationFrame(scanQRCode);
            }
        }

        function consultarEstadoEscaneo(qrCode) {
            mostrarMensaje('<i class="bi bi-hourglass-split me-1"></i> Identificando código QR y consultando estado...', 'info');

            fetch('/consultar-estado-scan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ qr_code: qrCode })
            })
            .then(res => res.json())
            .then(data => {
                ocultarMensaje();
                if (data.error) {
                    playBeep('error');
                    actionButtonsDiv.style.display = 'flex';
                    if (data.blocked) {
                        employeeCardDiv.className = 'alert alert-danger p-3 my-3 shadow-sm text-start d-block';
                        employeeCardDiv.innerHTML = `
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-lock-fill fs-3 text-danger flex-shrink-0"></i>
                                <div>
                                    <h6 class="fw-bold text-danger mb-1">Código QR Bloqueado</h6>
                                    <div class="small text-dark mb-2">${data.message}</div>
                                    <div class="small text-muted"><i class="bi bi-person-badge me-1"></i> Empleado: <strong>${data.empleado ? data.empleado.nombre + ' ' + (data.empleado.apellido || '') : 'Desconocido'}</strong></div>
                                </div>
                            </div>
                        `;
                    } else {
                        mostrarMensaje(`<i class="bi bi-x-circle-fill me-1"></i> ${data.message}`, 'danger');
                    }
                    reiniciarScanButton.classList.remove('d-none');
                    return;
                }

                playBeep('success');
                currentScanData = data;

                // Renderizar Tarjeta de Información Inteligente
                employeeCardDiv.className = 'card p-3 my-3 border-0 bg-light shadow-sm text-start d-block';
                const emp = data.empleado;
                const tieneEntrada = data.tieneEntradaHoy;

                employeeCardDiv.innerHTML = `
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-bold fs-5 text-dark">${emp.nombre}</span>
                        <span class="badge bg-secondary">C.I: V-${emp.cedula}</span>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                        <span class="badge badge-alba-amber"><i class="bi bi-briefcase me-1"></i> ${emp.cargo}</span>
                        <span class="badge badge-alba-slate"><i class="bi bi-building me-1"></i> ${emp.departamento}</span>
                        <span class="badge badge-alba-emerald"><i class="bi bi-clock me-1"></i> Turno: ${emp.tipo_jornada}</span>
                    </div>
                    <div class="p-2 rounded-2 ${tieneEntrada ? 'bg-info-subtle text-info-emphasis' : 'bg-success-subtle text-success-emphasis'} small fw-semibold mt-2">
                        <i class="bi bi-${tieneEntrada ? 'box-arrow-right' : 'box-arrow-in-right'} me-1"></i> ${data.mensajeEstado}
                    </div>
                `;

                // Hacer visible el contenedor de botones
                actionButtonsDiv.style.display = 'flex';

                // Mostrar SOLO el botón correspondiente a la acción lógica
                if (tieneEntrada) {
                    registrarSalidaButton.classList.remove('d-none');
                    registrarEntradaButton.classList.add('d-none');
                } else {
                    registrarEntradaButton.classList.remove('d-none');
                    registrarSalidaButton.classList.add('d-none');
                }
                reiniciarScanButton.classList.remove('d-none');
            })
            .catch(err => {
                console.error('Error al consultar estado:', err);
                playBeep('error');
                actionButtonsDiv.style.display = 'flex';
                mostrarMensaje('<i class="bi bi-wifi-off me-1"></i> Error de conexión al consultar el QR.', 'danger');
                reiniciarScanButton.classList.remove('d-none');
            });
        }

        function registrarAsistencia(tipo, qrCode, observacion = null) {
            mostrarMensaje(`<i class="bi bi-hourglass-split me-1"></i> Registrando marcaje de ${tipo}...`, 'info');

            fetch('/registrar-asistencia', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ qr_code: qrCode, tipo: tipo, observacion: observacion })
            })
            .then(response => response.json())
            .then(data => {
                employeeCardDiv.className = 'd-none';
                actionButtonsDiv.style.display = 'none';
                registrarEntradaButton.classList.add('d-none');
                registrarSalidaButton.classList.add('d-none');

                if (data.error) {
                    playBeep('error');
                    mostrarMensaje(`<i class="bi bi-x-circle-fill me-1"></i> ${data.message}`, 'danger');
                } else {
                    playBeep('success');
                    mostrarMensaje(`<i class="bi bi-check-circle-fill me-1"></i> ${data.message}`, 'success');
                }
                scannedCode = null;
                currentScanData = null;
            })
            .catch(error => {
                playBeep('error');
                actionButtonsDiv.style.display = 'none';
                mostrarMensaje('<i class="bi bi-wifi-off me-1"></i> Error de conexión al registrar asistencia.', 'danger');
                scannedCode = null;
                currentScanData = null;
            });
        }
    </script>
</body>
</html>