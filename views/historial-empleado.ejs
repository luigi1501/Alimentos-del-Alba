<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Historial de Asistencia — Alimentos del Alba</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/stylesheets/main-theme.css">
    <link rel="shortcut icon" href="/images/logo2.jpg" type="image/x-icon">
</head>
<body>

    <!-- Header Navbar Exclusivo para Empleados -->
    <header class="alba-navbar">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a href="/auth/panel-empleado" class="navbar-brand">
                <img src="/images/logo2.jpg" alt="Logo Alba" class="brand-logo">
                <span>Alimentos del Alba <span class="badge badge-alba-emerald ms-2">Mi Perfil</span></span>
            </a>
            <div class="d-flex align-items-center gap-2">
                <a href="/auth/panel-empleado" class="btn btn-sm btn-alba-secondary">
                    <i class="bi bi-person-badge me-1"></i> Mi Panel
                </a>
                <a href="/auth/logout" class="btn btn-sm btn-alba-danger">
                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                </a>
            </div>
        </div>
    </header>

    <main class="container my-4">

        <!-- Banner Header -->
        <div class="alba-hero-mini">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h1 class="h2 fw-bold text-white mb-2">
                        <i class="bi bi-calendar-check text-warning me-2"></i> Mi Historial de Asistencia
                    </h1>
                    <p class="text-slate-400 mb-0">
                        Consulta el registro completo de tus entradas y salidas laborales.
                        <% if (locals.empleado) { %>
                            <span class="text-light fw-medium d-block mt-1">Empleado: <%= empleado.nombre %> <%= empleado.apellido || '' %> (C.I: <%= empleado.cedula %>)</span>
                        <% } %>
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <span class="badge badge-alba-amber fs-6 px-3 py-2">
                        <i class="bi bi-list-check me-1"></i> <%= (historial && historial.length) ? historial.length : 0 %> Registros
                    </span>
                </div>
            </div>
        </div>

        <!-- Filter Search Bar -->
        <div class="alba-card p-3 mb-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="filter-input" class="form-control border-start-0 ps-0" placeholder="Buscar por fecha, hora o estado de marcaje...">
            </div>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div><%= error %></div>
            </div>
        <% } %>

        <!-- History Table -->
        <div class="alba-table-container">
            <div class="table-responsive">
                <table class="alba-table" id="tabla-historial-propio">
                    <thead>
                        <tr>
                            <th># Registro</th>
                            <th>Fecha</th>
                            <th>Hora de Entrada</th>
                            <th>Hora de Salida</th>
                            <th>Estado de Jornada</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (historial && historial.length > 0) { %>
                            <% historial.forEach(registro => { %>
                                <tr>
                                    <td class="fw-bold text-muted">#<%= registro.id_asistencia %></td>
                                    <td>
                                        <i class="bi bi-calendar3 me-1 text-primary"></i>
                                        <strong class="text-dark"><%= registro.fechaFormatted || registro.fecha %></strong>
                                    </td>
                                    <td>
                                        <span class="text-success fw-semibold">
                                            <i class="bi bi-box-arrow-in-right me-1"></i><%= registro.horaEntradaFormatted || registro.hora_entrada %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (registro.hora_salida && registro.hora_salida !== 'N/A') { %>
                                            <span class="text-primary fw-semibold">
                                                <i class="bi bi-box-arrow-left me-1"></i><%= registro.horaSalidaFormatted || registro.hora_salida %>
                                            </span>
                                        <% } else { %>
                                            <span class="text-warning fw-semibold">
                                                <i class="bi bi-clock-history me-1"></i> Pendiente
                                            </span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (registro.hora_salida && registro.hora_salida !== 'N/A') { %>
                                            <span class="badge badge-alba-emerald"><i class="bi bi-check-circle-fill me-1"></i> Jornada Completa</span>
                                        <% } else { %>
                                            <span class="badge badge-alba-amber"><i class="bi bi-hourglass-split me-1"></i> En Jornada</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-warning"></i>
                                    Aún no tienes registros de asistencia en tu historial.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const filterInput = document.getElementById('filter-input');
            const tbody = document.querySelector('#tabla-historial-propio tbody');
            const rows = tbody.querySelectorAll('tr');

            if (filterInput && tbody) {
                filterInput.addEventListener('input', function() {
                    const query = this.value.toLowerCase().trim();
                    rows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(query) ? '' : 'none';
                    });
                });
            }
        });
    </script>
</body>
</html>
